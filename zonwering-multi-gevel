variables:
  rain_entity: !input rain_entity
  radiation_entity: !input radiation_entity
  sun_strength_threshold: !input sun_strength_threshold
  azimuth_entity: !input azimuth_entity
  elevation_entity: !input elevation_entity
  heat_avg_temp_entity: !input heat_avg_temp_entity
  heat_threshold: !input heat_threshold
  heating_enabled_entities: !input heating_enabled_entities
  heat_forecast_entities: !input heat_forecast_entities
  indoor_avg_entities: !input indoor_avg_entities
  indoor_avg_threshold: !input indoor_avg_threshold

  facade_a_heat_mode: !input facade_a_heat_mode
  facade_a_lux_entities: !input facade_a_lux_entities
  facade_a_lux_threshold: !input facade_a_lux_threshold
  facade_a_lux_threshold_entity: !input facade_a_lux_threshold_entity
  facade_a_lux_offset: !input facade_a_lux_offset
  facade_a_react_to_rain: !input facade_a_react_to_rain
  facade_a_covers: !input facade_a_covers
  facade_a_azimuth: !input facade_a_azimuth
  facade_a_min_elevation: !input facade_a_min_elevation
  facade_a_sun_window: !input facade_a_sun_window
  facade_a_season_correction: !input facade_a_season_correction
  facade_a_season_strength: !input facade_a_season_strength
  facade_a_cooldown_minutes: !input facade_a_cooldown_minutes
  facade_a_direction: !input facade_a_direction
  facade_a_closed_position: !input facade_a_closed_position
  facade_a_open_position: !input facade_a_open_position

  facade_b_heat_mode: !input facade_b_heat_mode
  facade_b_lux_entities: !input facade_b_lux_entities
  facade_b_lux_threshold: !input facade_b_lux_threshold
  facade_b_lux_threshold_entity: !input facade_b_lux_threshold_entity
  facade_b_lux_offset: !input facade_b_lux_offset
  facade_b_react_to_rain: !input facade_b_react_to_rain
  facade_b_covers: !input facade_b_covers
  facade_b_azimuth: !input facade_b_azimuth
  facade_b_min_elevation: !input facade_b_min_elevation
  facade_b_sun_window: !input facade_b_sun_window
  facade_b_season_correction: !input facade_b_season_correction
  facade_b_season_strength: !input facade_b_season_strength
  facade_b_cooldown_minutes: !input facade_b_cooldown_minutes
  facade_b_direction: !input facade_b_direction
  facade_b_closed_position: !input facade_b_closed_position
  facade_b_open_position: !input facade_b_open_position

  v_raining: "{{ is_state(rain_entity, 'on') }}"

  v_outdoor_avg: "{{ states(heat_avg_temp_entity) | float(99) }}"
  v_heating_enabled: "{{ heating_enabled_entities | select('is_state', 'on') | list | count > 0 }}"
  # Geen of onbeschikbare binnensensor: alleen de buitentemperatuur telt.
  v_indoor_avg: >
    {% set t = states(indoor_avg_entities | first) if indoor_avg_entities | count > 0 else 'none' %}
    {{ t | float if is_number(t) else 'none' }}
  # 'on'/'off' van de warmtevoorspelling, 'none' als die niet ingevuld of
  # onbeschikbaar is (dan telt de stookgrens).
  v_heat_forecast: >
    {% set f = states(heat_forecast_entities | first) if heat_forecast_entities | count > 0 else 'none' %}
    {{ f if f in ['on', 'off'] else 'none' }}
  v_heat_expected: >
    {{ v_heat_forecast == 'on' if v_heat_forecast != 'none'
       else v_outdoor_avg | float(99) < heat_threshold | float }}
  v_heat_needed: >
    {{ v_heating_enabled | bool
       or (v_heat_expected | bool
           and (not is_number(v_indoor_avg) or v_indoor_avg | float < indoor_avg_threshold | float)) }}
  v_heat_reason: >
    {% set hours = state_attr(heat_forecast_entities | first, 'uren_tot_warmtevraag') if heat_forecast_entities | count > 0 else none %}
    {{ 'warmtemodus (verwarming vrijgegeven)' if v_heating_enabled | bool
       else 'warmtemodus (' ~ ('voorspelling: warmte nodig' ~ ((' over ' ~ hours ~ ' u') if is_number(hours) else '')
                               if v_heat_forecast != 'none'
                               else 'buiten gem. ' ~ v_outdoor_avg ~ '°C < ' ~ heat_threshold ~ '°C')
            ~ ((', binnen gem. ' ~ v_indoor_avg ~ '°C < ' ~ indoor_avg_threshold ~ '°C') if is_number(v_indoor_avg) else '') ~ ')' }}

  # Heldere-hemelstraling op een horizontaal vlak bij de huidige zonshoogte
  # (Haurwitz); gemeten straling als percentage daarvan is seizoensonafhankelijk.
  v_clear_sky_radiation: >
    {% set h = states(elevation_entity) | float(-90) %}
    {% set s = sin(h * pi / 180) %}
    {{ 1098 * s * e ** (-0.057 / s) if h > 5 else 0 }}
  v_sun_strength: >
    {% set clear = v_clear_sky_radiation | float(0) %}
    {{ 100 * (states(radiation_entity) | float(0)) / clear if clear > 0 else 0 }}

  v_sun_strong: "{{ v_sun_strength | float(0) >= sun_strength_threshold | float }}"

  # Verhouding tussen de halve zonneboog (zuid -> zonsondergang) op de langste
  # dag en vandaag; > 1 buiten de zomer. Declinatie benaderd uit de dag van het jaar.
  v_sun_arc_ratio: >
    {% set lat = (state_attr('zone.home', 'latitude') | float(52)) * pi / 180 %}
    {% set doy = now().strftime('%j') | int %}
    {% set decl = 23.44 * sin(2 * pi * (doy - 81) / 365) * pi / 180 %}
    {% set decl_ref = 23.44 * pi / 180 %}
    {% set x = [[sin(decl) / cos(lat), 0.99] | min, -0.99] | max %}
    {% set x_ref = [[sin(decl_ref) / cos(lat), 0.99] | min, -0.99] | max %}
    {% set arc = 180 - acos(x) * 180 / pi %}
    {% set arc_ref = 180 - acos(x_ref) * 180 / pi %}
    {{ arc_ref / arc }}

  v_sun_azimuth: "{{ states(azimuth_entity) | float(0) }}"

  v_facade_a_azimuth_eff: >
    {% set r = (v_sun_azimuth | float % 360) - 180 %}
    {% if (r >= 0 and facade_a_season_correction in ['afternoon', 'both'])
       or (r < 0 and facade_a_season_correction in ['morning', 'both']) %}
      {% set r = r * (1 + (facade_a_season_strength | float(100)) / 100 * (v_sun_arc_ratio | float(1) - 1)) %}
    {% endif %}
    {{ 180 + r }}

  v_facade_a_in_window: >
    {% set diff = ((v_facade_a_azimuth_eff | float - facade_a_azimuth | float + 180) % 360) - 180 %}
    {{ (diff | abs) <= (facade_a_sun_window | float)
       and (states(elevation_entity) | float(-90) >= facade_a_min_elevation | float) }}

  v_facade_a_can_open: "{{ facade_a_direction in ['both', 'open_only'] }}"
  v_facade_a_can_close: "{{ facade_a_direction in ['both', 'close_only'] }}"

  v_facade_a_rain_active: "{{ v_raining | bool and facade_a_react_to_rain | bool }}"
  v_facade_a_heat_active: "{{ v_heat_needed | bool and facade_a_heat_mode | bool }}"
  v_facade_a_lux: >
    {% set l = states(facade_a_lux_entities | first) if facade_a_lux_entities | count > 0 else 'none' %}
    {{ l | float if is_number(l) else 'none' }}
  v_facade_a_lux_limit: >
    {% set te = states(facade_a_lux_threshold_entity | first) if facade_a_lux_threshold_entity | count > 0 else 'none' %}
    {{ te | float + facade_a_lux_offset | float(0) if is_number(te) else facade_a_lux_threshold | float }}
  v_facade_a_dark: >
    {{ is_number(v_facade_a_lux) and v_facade_a_lux | float < v_facade_a_lux_limit | float
       and v_facade_a_in_window | bool and not v_sun_strong | bool }}
  v_facade_a_force_close: >
    {{ (not v_facade_a_rain_active | bool) and (not v_facade_a_heat_active | bool)
       and v_facade_a_in_window | bool and v_sun_strong | bool }}
  v_facade_a_force_open: >
    {{ v_facade_a_rain_active | bool or v_facade_a_heat_active | bool
       or v_facade_a_dark | bool or not (v_facade_a_in_window | bool) }}
  v_facade_a_action_close: "{{ v_facade_a_force_close | bool and v_facade_a_can_close | bool }}"
  v_facade_a_action_open: "{{ v_facade_a_force_open | bool and v_facade_a_can_open | bool }}"
  v_facade_a_target: "{{ facade_a_closed_position | int if v_facade_a_action_close | bool else facade_a_open_position | int }}"

  v_facade_a_reason: >
    {% set why = 'regen' if v_facade_a_rain_active | bool
       else v_heat_reason if v_facade_a_heat_active | bool
       else ('te donker binnen (' ~ (v_facade_a_lux | float(0) | round(0) | int) ~ ' lx < ' ~ (v_facade_a_lux_limit | float(0) | round(0) | int) ~ ' lx, zonkracht ' ~ (v_sun_strength | float(0) | round(0) | int) ~ '% < ' ~ sun_strength_threshold ~ '%)') if v_facade_a_dark | bool
       else 'zon buiten zonvenster' %}
    {{ why ~ ' -> open'
       if v_facade_a_force_open | bool and v_facade_a_can_open | bool
       else why ~ ' -> zou open moeten, maar richting staat op alleen sluiten'
       if v_facade_a_force_open | bool
       else 'zon in venster + zonkracht ' ~ (v_sun_strength | float(0) | round(0) | int) ~ '% -> dicht'
       if v_facade_a_force_close | bool and v_facade_a_can_close | bool
       else 'zon in venster + zonkracht boven drempel -> zou dicht moeten, maar richting staat op alleen openen'
       if v_facade_a_force_close | bool
       else 'zon in venster, zonkracht ' ~ (v_sun_strength | float(0) | round(0) | int) ~ '% < ' ~ sun_strength_threshold ~ '% -> ongewijzigd' }}

  v_facade_a_override_active: >
    {% set ns = namespace(active=false) %}
    {% for c in facade_a_covers %}
      {% set st = states[c] %}
      {% if st is not none and st.context.user_id is not none and st.last_updated.date() == now().date() %}
        {% set ns.active = true %}
      {% endif %}
    {% endfor %}
    {{ ns.active }}

  v_facade_a_cooldown_ok: >
    {% set secs = facade_a_cooldown_minutes | float(20) * 60 %}
    {% set ns = namespace(ok=true) %}
    {% for c in facade_a_covers %}
      {% if (as_timestamp(now()) - as_timestamp(states[c].last_updated)) < secs %}
        {% set ns.ok = false %}
      {% endif %}
    {% endfor %}
    {{ ns.ok }}

  v_facade_a_needs_move: >
    {% set target = v_facade_a_target | int %}
    {% set ns = namespace(needs=false) %}
    {% for c in facade_a_covers %}
      {% if state_attr(c, 'current_position') | int(-1) != target %}
        {% set ns.needs = true %}
      {% endif %}
    {% endfor %}
    {{ ns.needs }}

  v_facade_b_azimuth_eff: >
    {% set r = (v_sun_azimuth | float % 360) - 180 %}
    {% if (r >= 0 and facade_b_season_correction in ['afternoon', 'both'])
       or (r < 0 and facade_b_season_correction in ['morning', 'both']) %}
      {% set r = r * (1 + (facade_b_season_strength | float(100)) / 100 * (v_sun_arc_ratio | float(1) - 1)) %}
    {% endif %}
    {{ 180 + r }}

  v_facade_b_in_window: >
    {% set diff = ((v_facade_b_azimuth_eff | float - facade_b_azimuth | float + 180) % 360) - 180 %}
    {{ (diff | abs) <= (facade_b_sun_window | float)
       and (states(elevation_entity) | float(-90) >= facade_b_min_elevation | float) }}

  v_facade_b_can_open: "{{ facade_b_direction in ['both', 'open_only'] }}"
  v_facade_b_can_close: "{{ facade_b_direction in ['both', 'close_only'] }}"

  v_facade_b_rain_active: "{{ v_raining | bool and facade_b_react_to_rain | bool }}"
  v_facade_b_heat_active: "{{ v_heat_needed | bool and facade_b_heat_mode | bool }}"
  v_facade_b_lux: >
    {% set l = states(facade_b_lux_entities | first) if facade_b_lux_entities | count > 0 else 'none' %}
    {{ l | float if is_number(l) else 'none' }}
  v_facade_b_lux_limit: >
    {% set te = states(facade_b_lux_threshold_entity | first) if facade_b_lux_threshold_entity | count > 0 else 'none' %}
    {{ te | float + facade_b_lux_offset | float(0) if is_number(te) else facade_b_lux_threshold | float }}
  v_facade_b_dark: >
    {{ is_number(v_facade_b_lux) and v_facade_b_lux | float < v_facade_b_lux_limit | float
       and v_facade_b_in_window | bool and not v_sun_strong | bool }}
  v_facade_b_force_close: >
    {{ (not v_facade_b_rain_active | bool) and (not v_facade_b_heat_active | bool)
       and v_facade_b_in_window | bool and v_sun_strong | bool }}
  v_facade_b_force_open: >
    {{ v_facade_b_rain_active | bool or v_facade_b_heat_active | bool
       or v_facade_b_dark | bool or not (v_facade_b_in_window | bool) }}
  v_facade_b_action_close: "{{ v_facade_b_force_close | bool and v_facade_b_can_close | bool }}"
  v_facade_b_action_open: "{{ v_facade_b_force_open | bool and v_facade_b_can_open | bool }}"
  v_facade_b_target: "{{ facade_b_closed_position | int if v_facade_b_action_close | bool else facade_b_open_position | int }}"

  v_facade_b_reason: >
    {% set why = 'regen' if v_facade_b_rain_active | bool
       else v_heat_reason if v_facade_b_heat_active | bool
       else ('te donker binnen (' ~ (v_facade_b_lux | float(0) | round(0) | int) ~ ' lx < ' ~ (v_facade_b_lux_limit | float(0) | round(0) | int) ~ ' lx, zonkracht ' ~ (v_sun_strength | float(0) | round(0) | int) ~ '% < ' ~ sun_strength_threshold ~ '%)') if v_facade_b_dark | bool
       else 'zon buiten zonvenster' %}
    {{ why ~ ' -> open'
       if v_facade_b_force_open | bool and v_facade_b_can_open | bool
       else why ~ ' -> zou open moeten, maar richting staat op alleen sluiten'
       if v_facade_b_force_open | bool
       else 'zon in venster + zonkracht ' ~ (v_sun_strength | float(0) | round(0) | int) ~ '% -> dicht'
       if v_facade_b_force_close | bool and v_facade_b_can_close | bool
       else 'zon in venster + zonkracht boven drempel -> zou dicht moeten, maar richting staat op alleen openen'
       if v_facade_b_force_close | bool
       else 'zon in venster, zonkracht ' ~ (v_sun_strength | float(0) | round(0) | int) ~ '% < ' ~ sun_strength_threshold ~ '% -> ongewijzigd' }}

  v_facade_b_override_active: >
    {% set ns = namespace(active=false) %}
    {% for c in facade_b_covers %}
      {% set st = states[c] %}
      {% if st is not none and st.context.user_id is not none and st.last_updated.date() == now().date() %}
        {% set ns.active = true %}
      {% endif %}
    {% endfor %}
    {{ ns.active }}

  v_facade_b_cooldown_ok: >
    {% set secs = facade_b_cooldown_minutes | float(20) * 60 %}
    {% set ns = namespace(ok=true) %}
    {% for c in facade_b_covers %}
      {% if (as_timestamp(now()) - as_timestamp(states[c].last_updated)) < secs %}
        {% set ns.ok = false %}
      {% endif %}
    {% endfor %}
    {{ ns.ok }}

  v_facade_b_needs_move: >
    {% set target = v_facade_b_target | int %}
    {% set ns = namespace(needs=false) %}
    {% for c in facade_b_covers %}
      {% if state_attr(c, 'current_position') | int(-1) != target %}
        {% set ns.needs = true %}
      {% endif %}
    {% endfor %}
    {{ ns.needs }}

action:
  # Gevel A
  # Cooldown genegeerd zolang v_facade_a_rain_active waar is (het regent en
  # facade_a_react_to_rain staat aan), zodat de zonwering direct omhoog gaat
  # i.p.v. nat te worden; bij einde regen geldt de cooldown weer normaal.
  - if:
      - condition: template
        alias: "Covers geconfigureerd voor gevel A"
