# Alleen triggeren op momenten waarop er iets kan veranderen; elke run levert
# een trace op, dus op elke sensorupdate triggeren verdringt de relevante traces.
trigger:
  - platform: state
    entity_id: !input rain_entity
    to: ~
    id: rain
  # Zonkracht gaat over de drempel. Moet exact dezelfde berekening zijn als
  # v_sun_strength en v_sun_strong.
  - platform: template
    id: radiation
    for: "00:05:00"
