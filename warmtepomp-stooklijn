# Version: 1.1.0
blueprint:
  domain: automation
  name: "🔥 Warmtepomp - stooklijn (DAO + binnentemperatuur)"
  description: >
    Schrijft de stooklijncorrectie naar de warmtepomp: de aanpassing van de
    Day Ahead Optimizer (DAO) plus een compensatie op de binnentemperatuur.
    De aanpassing volgt het warmteplan van de DAO (bron 'DAO-plan'): de DAO
    verdeelt de warmte van de dag (graaddagenfactor x graaddagen min al
    geproduceerd) over de goedkoopste kwartieren en zet het geplande
    vermogen in 'entity hp power'. Plant de DAO meer warmte dan het huis nu
    verliest, dan gaat de stooklijn omhoog (bufferen); plant hij minder of
    niets, dan omlaag. Met bron 'DAO-prijs' wordt de prijsaanpassing van de
    DAO ('entity adjust heating curve') gebruikt; die kijkt alleen naar de
    prijs t.o.v. het daggemiddelde, niet naar de warmtebehoefte.
    De compensatie werkt alleen buiten een comfortband, zodat de DAO binnen de
    band vrij kan voorstoken of uitstellen. De band ligt rond het actuele
    setpoint van een referentiethermostaat; verhoogt de blueprint
    'Thermostaten - bufferen met Day Ahead Optimizer' dat setpoint in een
    goedkoop uur, dan schuift de band mee en helpt de compensatie de vloer
    opladen in plaats van het tegen te werken. Zonder referentiethermostaat
    geldt een vaste band. Er wordt alleen geschreven als de waarde verandert,
    afgerond op de stap van de doel-entiteit en begrensd op het minimum en
    maximum ervan. Staat de verwarming uit, dan gaan de correctie en de
    helpers terug naar 0. Vervangt een losse compensatie- en schrijfautomation. De
    variabele v_reason in de trace toont de opbouw van de correctie.

  input:
    source:
      name: "📋 Bron van de aanpassing"
      description: >
        DAO-plan: stooklijn volgt het geplande vermogen van de DAO (warmte op de
        goedkoopste momenten, alleen zoveel als nodig is). DAO-prijs: de
        prijsaanpassing van de DAO.
      default: plan
      selector:
        select:
          options:
            - label: DAO-plan (gepland vermogen)
              value: plan
            - label: DAO-prijs (stooklijnaanpassing)
              value: price

    planned_power_entity:
      name: "⚡ Gepland vermogen van de DAO"
      description: >
        De entiteit waarin de DAO het geplande elektrische vermogen van de
        warmtepomp voor het huidige kwartier schrijft ('entity hp power'), in
        kW (waarden boven 20 worden als W gelezen).
      default: input_number.warmtepomp_gevraagd_vermogen
      selector:
        entity:
          filter:
            - domain: [input_number, number, sensor]

    cop_entity:
      name: "COP warmtepomp"
      description: >
        Sensor met de actuele COP ('entity hp cop' van de DAO). Geplande warmte =
        gepland vermogen x COP. Onbeschikbaar: de vaste COP hieronder.
      default: sensor.warmtepomp_cop
      selector:
        entity:
          filter:
            - domain: [sensor, input_number]

    cop_fixed:
      name: "Vaste COP (terugval)"
      default: 5.5
      selector:
        number:
          min: 1
          max: 10
          step: 0.1
          mode: slider

    demand_entity:
      name: "🏠 Actuele warmtevraag"
      description: >
        Wat het huis nu verliest, in kW (sensor.warmtevraag_actueel uit het
        package). Geplande warmte boven deze waarde wordt gebufferd.
      default: sensor.warmtevraag_actueel
      selector:
        entity:
          filter:
            - domain: sensor

    plan_gain:
      name: "Stooklijn per kW"
      description: >
        Graden stooklijnverschuiving per kW verschil tussen geplande warmte en
        warmtevraag. Gemeten in oktober: 1 K stooklijn geeft ~0,4 kW meer
        warmte, dus ~2,5 K per kW.
      default: 2.5
      selector:
        number:
          min: 0.5
          max: 5
          step: 0.1
          unit_of_measurement: "K/kW"
          mode: slider

    plan_max_up:
      name: "Plan: maximaal omhoog"
      default: 3
      selector:
        number:
          min: 0
          max: 5
          step: 0.5
          unit_of_measurement: "K"
          mode: slider

    plan_max_down:
      name: "Plan: maximaal omlaag"
      description: Als de DAO niets plant; de thermostaten blijven het vangnet.
      default: 2
      selector:
        number:
          min: 0
          max: 5
          step: 0.5
          unit_of_measurement: "K"
          mode: slider

    plan_helper:
      name: "Helper plan-aanpassing (optioneel)"
      description: >
        input_number (-5..5, stap 0,1) die de aanpassing uit het plan bijhoudt.
        Gebruik deze als 'Stooklijnaanpassing' in de blueprint 'Thermostaten -
        bufferen met Day Ahead Optimizer', zodat de setpoints het plan volgen.
      default: []
      selector:
        entity:
          multiple: true
          filter:
            - domain: input_number

    adjustment_entity:
      name: "💶 Stooklijnaanpassing van de DAO"
      description: >
        Alleen bij bron DAO-prijs: de entiteit waarin de DAO de
        stooklijnaanpassing schrijft ('entity adjust heating curve'), in K.
      default: input_number.stooklijn_aanpassing
      selector:
        entity:
          filter:
            - domain: [input_number, number, sensor]

    target_entity:
      name: "🎯 Stooklijncorrectie warmtepomp"
      description: Number-entiteit van de warmtepomp waarin de correctie wordt geschreven.
      default: number.luxtronik_281211_0164_heating_target_correction
      selector:
        entity:
          filter:
            - domain: [number, input_number]

    heating_entities:
      name: "🔥 Verwarming vrijgegeven"
      description: >
        Schakelaar of select die aangeeft dat de verwarming vrijgegeven is.
        Elke status behalve off/unavailable/unknown telt als vrijgegeven.
        Staat de verwarming uit, dan gaan de correctie en de helpers naar 0.
      default:
        - switch.luxtronik_281211_0164_heating
      selector:
        entity:
          multiple: true
          filter:
            - domain: [switch, select, input_select, input_boolean, binary_sensor]

    temperature_entity:
      name: "🌡️ Binnentemperatuur"
      description: Temperatuursensor waarop gecompenseerd wordt.
      default: sensor.woonkamer_temperatuur
      selector:
        entity:
          filter:
            - domain: sensor

    reference_thermostat:
      name: "🌡️ Referentiethermostaat (optioneel)"
      description: >
        Thermostaat van dezelfde ruimte. De comfortband ligt dan rond zijn
        actuele setpoint (van 'onder setpoint' tot 'boven setpoint') en schuift
        mee met het bufferen. Leeg laten: vaste band hieronder.
      default:
        - climate.woonkamer
      selector:
        entity:
          multiple: true
          filter:
            - domain: climate

    band_below:
      name: "Band: onder setpoint"
      description: Onder setpoint min deze waarde wordt de stooklijn verhoogd.
      default: 0.2
      selector:
        number:
          min: 0
          max: 2
          step: 0.1
          unit_of_measurement: "°C"
          mode: slider

    band_above:
      name: "Band: boven setpoint"
      description: Boven setpoint plus deze waarde wordt de stooklijn verlaagd.
      default: 0.8
      selector:
        number:
          min: 0
          max: 2
          step: 0.1
          unit_of_measurement: "°C"
          mode: slider

    band_low:
      name: "Vaste band: ondergrens"
      description: Alleen zonder referentiethermostaat.
      default: 20.8
      selector:
        number:
          min: 15
          max: 25
          step: 0.1
          unit_of_measurement: "°C"
          mode: slider

    band_high:
      name: "Vaste band: bovengrens"
      description: Alleen zonder referentiethermostaat.
      default: 22.0
      selector:
        number:
          min: 15
          max: 25
          step: 0.1
          unit_of_measurement: "°C"
          mode: slider

    max_compensation:
      name: "Maximale compensatie"
      default: 0.7
      selector:
        number:
          min: 0
          max: 3
          step: 0.1
          unit_of_measurement: "K"
          mode: slider

    compensation_helper:
      name: "Helper compensatie (optioneel)"
      description: input_number die de compensatie bijhoudt, voor dashboard en historie.
      default:
        - input_number.stooklijn_compensatie
      selector:
        entity:
          multiple: true
          filter:
            - domain: input_number

    total_helper:
      name: "Helper totaal (optioneel)"
      description: input_number die de geschreven correctie bijhoudt, voor dashboard en historie.
      default:
        - input_number.stooklijn_totaal
      selector:
        entity:
          multiple: true
          filter:
            - domain: input_number

mode: queued
max: 3
max_exceeded: silent

trigger_variables:
  tv_heating: !input heating_entities

trigger:
  - platform: state
    entity_id: !input adjustment_entity
    id: dao
  - platform: state
    entity_id: !input planned_power_entity
    id: dao
  - platform: template
    id: heating
    value_template: >
      {{ tv_heating | reject('is_state', ['off', 'unavailable', 'unknown']) | list | count > 0 }}
  - platform: template
    id: heating
    value_template: >
      {{ tv_heating | reject('is_state', ['off', 'unavailable', 'unknown']) | list | count == 0 }}
  # Vloerverwarming reageert in uren; elk kwartier bijsturen is genoeg. Een
  # verschoven setpoint van de referentiethermostaat wordt zo ook opgepakt.
  - platform: time_pattern
    minutes: "/15"
    id: interval
  - platform: homeassistant
    event: start
    id: start

variables:
  source: !input source
  planned_power_entity: !input planned_power_entity
  cop_entity: !input cop_entity
  cop_fixed: !input cop_fixed
  demand_entity: !input demand_entity
  plan_gain: !input plan_gain
  plan_max_up: !input plan_max_up
  plan_max_down: !input plan_max_down
  plan_helper: !input plan_helper
  adjustment_entity: !input adjustment_entity
  target_entity: !input target_entity
  heating_entities: !input heating_entities
  temperature_entity: !input temperature_entity
  reference_thermostat: !input reference_thermostat
  band_below: !input band_below
  band_above: !input band_above
  band_low: !input band_low
  band_high: !input band_high
  max_compensation: !input max_compensation
  compensation_helper: !input compensation_helper
  total_helper: !input total_helper

  v_heating_on: >
    {{ heating_entities | reject('is_state', ['off', 'unavailable', 'unknown']) | list | count > 0 }}
  v_plan_heat: >
    {% set p = states(planned_power_entity) %}
    {% set p = p | float if is_number(p) else 0 %}
    {% set p = p / 1000 if p > 20 else p %}
    {% set c = states(cop_entity) %}
    {% set c = c | float if is_number(c) and c | float > 0 else cop_fixed | float %}
    {{ (p * c) | round(2) }}
  v_demand: >
    {% set d = states(demand_entity) %}
    {{ d | float if is_number(d) else 'none' }}
  v_plan_adjustment: >
    {% if is_number(v_demand) %}
      {% set a = plan_gain | float * (v_plan_heat | float - [v_demand | float, 0] | max) %}
      {{ [[a, plan_max_up | float] | min, -(plan_max_down | float)] | max | round(1) }}
    {% else %}0{% endif %}
  v_adjustment: >
    {% if source == 'plan' %}{{ v_plan_adjustment }}
    {% else %}
      {% set a = states(adjustment_entity) %}
      {{ a | float if is_number(a) else 0 }}
    {% endif %}
  v_temperature: >
    {% set t = states(temperature_entity) %}
    {{ t | float if is_number(t) else 'none' }}
  v_setpoint: >
    {% set s = state_attr(reference_thermostat | first, 'temperature') if reference_thermostat | count > 0 else none %}
    {{ s | float if is_number(s) else 'none' }}
  v_band_low: >
    {{ (v_setpoint | float - band_below | float) | round(2) if is_number(v_setpoint) else band_low | float }}
  v_band_high: >
    {{ (v_setpoint | float + band_above | float) | round(2) if is_number(v_setpoint) else band_high | float }}
  v_compensation: >
    {% if not v_heating_on | bool or not is_number(v_temperature) %}0
    {% elif v_temperature | float < v_band_low | float %}
      {{ [v_band_low | float - v_temperature | float, max_compensation | float] | min | round(1) }}
    {% elif v_temperature | float > v_band_high | float %}
      {{ [v_band_high | float - v_temperature | float, -(max_compensation | float)] | max | round(1) }}
    {% else %}0{% endif %}
  v_total: >
    {% set stap = state_attr(target_entity, 'step') | float(0.1) %}
    {% set v = v_adjustment | float + v_compensation | float if v_heating_on | bool else 0 %}
    {% set v = [[v, state_attr(target_entity, 'min') | float(-5)] | max, state_attr(target_entity, 'max') | float(5)] | min %}
    {{ ((v / stap) | round(0) * stap) | round(1) }}
  v_write: >
    {{ is_number(states(target_entity))
       and (states(target_entity) | float - v_total | float) | abs >= 0.05 }}

  v_reason: >
    {% if not v_heating_on | bool %}verwarming uit -> correctie 0{{ ' -> geschreven' if v_write | bool else ' (stond al op 0)' }}
    {% else %}
      {% set band = 'band ' ~ v_band_low ~ '-' ~ v_band_high ~ ' °C'
           ~ (' (setpoint ' ~ v_setpoint ~ ')' if is_number(v_setpoint) else ' (vast)') %}
      {% set temp = ('binnen ' ~ v_temperature ~ ' °C') if is_number(v_temperature) else 'binnentemperatuur onbekend' %}
      {% set bron = ('plan ' ~ v_plan_heat ~ ' kW warmte vs vraag ' ~ v_demand ~ ' kW -> ') if source == 'plan' else 'prijs -> ' %}
      {{ 'DAO ' ~ bron ~ v_adjustment ~ ' + compensatie ' ~ v_compensation ~ ' (' ~ temp ~ ', ' ~ band ~ ') = '
         ~ v_total ~ (' -> geschreven' if v_write | bool else ' -> ongewijzigd') }}
    {% endif %}

action:
  - if:
      - condition: template
        alias: "Warmtepomp bereikbaar"
        value_template: "{{ is_number(states(target_entity)) }}"
    then:
      - if:
          - condition: template
            alias: "Compensatie-helper ingesteld en gewijzigd"
            value_template: >
              {{ compensation_helper | count > 0
                 and states(compensation_helper | first) | float(99) != v_compensation | float }}
        then:
          - service: input_number.set_value
            target:
              entity_id: "{{ compensation_helper | first }}"
            data:
              value: "{{ v_compensation }}"
      - if:
          - condition: template
            alias: "Plan-helper ingesteld en gewijzigd"
            value_template: >
              {{ plan_helper | count > 0
                 and states(plan_helper | first) | float(99) != (v_plan_adjustment | float if v_heating_on | bool else 0) }}
        then:
          - service: input_number.set_value
            target:
              entity_id: "{{ plan_helper | first }}"
            data:
              value: "{{ v_plan_adjustment | float if v_heating_on | bool else 0 }}"
      - if:
          - condition: template
            alias: "Totaal-helper ingesteld en gewijzigd"
            value_template: >
              {{ total_helper | count > 0
                 and states(total_helper | first) | float(99) != v_total | float }}
        then:
          - service: input_number.set_value
            target:
              entity_id: "{{ total_helper | first }}"
            data:
              value: "{{ v_total }}"
      - if:
          - condition: template
            alias: "Correctie warmtepomp moet wijzigen"
            value_template: "{{ v_write | bool }}"
        then:
          - service: "{{ target_entity.split('.')[0] }}.set_value"
            target:
              entity_id: !input target_entity
            data:
              value: "{{ v_total }}"
