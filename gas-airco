# -------------------------
# Automatisering op basis van blueprint inputs
# -------------------------

trigger:
  - id: cheap
    platform: numeric_state
    entity_id: !input price_sensor
    below: 0.25
    for: !input hold_time

  - id: expensive
    platform: numeric_state
    entity_id: !input price_sensor
    above: 0.25
    for: !input hold_time

condition: []

action:
  - alias: Variabelen instellen
    variables:
      # inputs als variabelen
      price_sensor_var: !input price_sensor
      outside_entity_var: !input outside_entity
      target_temp: !input target_temp
      gas_setback_temp: !input gas_setback_temp
      price_threshold_low: !input price_threshold_low
      price_threshold_high: !input price_threshold_high
      outside_threshold_low: !input outside_threshold_low
      outside_threshold_high: !input outside_threshold_high

      # berekende waarden
      prijs: "{{ states(price_sensor_var) | float(0) }}"
      buiten: >
        {% set e = outside_entity_var %}
        {% set s = states(e) %}
        {# Sensor (state is temperatuur) vs Weather (attribuut 'temperature') #}
        {% if s not in ['unknown','unavailable','none'] and s is not none and (s | float(None)) is not none %}
          {{ s | float(0) }}
        {% else %}
          {{ state_attr(e, 'temperature') | float(0) }}
        {% endif %}

      # Zones (inputs naar variabelen, leeg = wordt overgeslagen)
      z1_name: !input zone1_name
      z1_gas: !input zone1_gas
      z1_ac: !input zone1_ac

      z2_name: !input zone2_name
      z2_gas: !input zone2_gas
      z2_ac: !input zone2_ac

      z3_name: !input zone3_name
      z3_gas: !input zone3_gas
      z3_ac: !input zone3_ac

      z4_name: !input zone4_name
      z4_gas: !input zone4_gas
      z4_ac: !input zone4_ac

      z5_name: !input zone5_name
      z5_gas: !input zone5_gas
      z5_ac: !input zone5_ac

      z6_name: !input zone6_name
      z6_gas: !input zone6_gas
      z6_ac: !input zone6_ac

      z7_name: !input zone7_name
      z7_gas: !input zone7_gas
      z7_ac: !input zone7_ac

      z8_name: !input zone8_name
      z8_gas: !input zone8_gas
      z8_ac: !input zone8_ac

      z9_name: !input zone9_name
      z9_gas: !input zone9_gas
      z9_ac: !input zone9_ac

      z10_name: !input zone10_name
      z10_gas: !input zone10_gas
      z10_ac: !input zone10_ac

      z11_name: !input zone11_name
      z11_gas: !input zone11_gas
      z11_ac: !input zone11_ac

      z12_name: !input zone12_name
      z12_gas: !input zone12_gas
      z12_ac: !input zone12_ac

  # -------------
  # CHEAP → naar AIRCO (hysteresis)
  # -------------
  - alias: Zones gas → airco (cheap + hysteresis)
    repeat:
      for_each:
        - {name: "{{ z1_name }}", gas: "{{ z1_gas }}", ac: "{{ z1_ac }}"}
        - {name: "{{ z2_name }}", gas: "{{ z2_gas }}", ac: "{{ z2_ac }}"}
        - {name: "{{ z3_name }}", gas: "{{ z3_gas }}", ac: "{{ z3_ac }}"}
        - {name: "{{ z4_name }}", gas: "{{ z4_gas }}", ac: "{{ z4_ac }}"}
        - {name: "{{ z5_name }}", gas: "{{ z5_gas }}", ac: "{{ z5_ac }}"}
        - {name: "{{ z6_name }}", gas: "{{ z6_gas }}", ac: "{{ z6_ac }}"}
        - {name: "{{ z7_name }}", gas: "{{ z7_gas }}", ac: "{{ z7_ac }}"}
        - {name: "{{ z8_name }}", gas: "{{ z8_gas }}", ac: "{{ z8_ac }}"}
        - {name: "{{ z9_name }}", gas: "{{ z9_gas }}", ac: "{{ z9_ac }}"}
        - {name: "{{ z10_name }}", gas: "{{ z10_gas }}", ac: "{{ z10_ac }}"}
        - {name: "{{ z11_name }}", gas: "{{ z11_gas }}", ac: "{{ z11_ac }}"}
        - {name: "{{ z12_name }}", gas: "{{ z12_gas }}", ac: "{{ z12_ac }}"}
      sequence:
        - choose:
            - conditions:
                # skip lege paren
                - condition: template
                  value_template: "{{ repeat.item.gas | length > 0 and repeat.item.ac | length > 0 }}"
                # branch cheap
                - condition: template
                  value_template: "{{ trigger.id == 'cheap' }}"
                # prijs ≤ low
                - condition: template
                  value_template: "{{ prijs <= price_threshold_low }}"
                # buiten ≥ high
                - condition: template
                  value_template: "{{ buiten >= outside_threshold_high }}"
                # setpoint gas = target_temp
                - condition: template
                  value_template: "{{ (state_attr(repeat.item.gas, 'temperature') | float(0)) == target_temp }}"
              sequence:
                - alias: "{{ repeat.item.name }}: airco naar heat"
                  service: climate.set_hvac_mode
                  target: { entity_id: "{{ repeat.item.ac }}" }
                  data: { hvac_mode: heat }

                - alias: "{{ repeat.item.name }}: airco set temperatuur (target)"
                  service: climate.set_temperature
                  target: { entity_id: "{{ repeat.item.ac }}" }
                  data: { temperature: "{{ target_temp }}" }

                - alias: "{{ repeat.item.name }}: gas naar setback (heat)"
                  service: climate.set_hvac_mode
                  target: { entity_id: "{{ repeat.item.gas }}" }
                  data: { hvac_mode: heat }

                - alias: "{{ repeat.item.name }}: gas set temperatuur (setback)"
                  service: climate.set_temperature
                  target: { entity_id: "{{ repeat.item.gas }}" }
                  data: { temperature: "{{ gas_setback_temp }}" }

  # -------------
  # EXPENSIVE → naar GAS (hysteresis)
  # -------------
  - alias: Zones airco → gas (expensive + hysteresis)
    repeat:
      for_each:
        - {name: "{{ z1_name }}", gas: "{{ z1_gas }}", ac: "{{ z1_ac }}"}
        - {name: "{{ z2_name }}", gas: "{{ z2_gas }}", ac: "{{ z2_ac }}"}
        - {name: "{{ z3_name }}", gas: "{{ z3_gas }}", ac: "{{ z3_ac }}"}
        - {name: "{{ z4_name }}", gas: "{{ z4_gas }}", ac: "{{ z4_ac }}"}
        - {name: "{{ z5_name }}", gas: "{{ z5_gas }}", ac: "{{ z5_ac }}"}
        - {name: "{{ z6_name }}", gas: "{{ z6_gas }}", ac: "{{ z6_ac }}"}
        - {name: "{{ z7_name }}", gas: "{{ z7_gas }}", ac: "{{ z7_ac }}"}
        - {name: "{{ z8_name }}", gas: "{{ z8_gas }}", ac: "{{ z8_ac }}"}
        - {name: "{{ z9_name }}", gas: "{{ z9_gas }}", ac: "{{ z9_ac }}"}
        - {name: "{{ z10_name }}", gas: "{{ z10_gas }}", ac: "{{ z10_ac }}"}
        - {name: "{{ z11_name }}", gas: "{{ z11_gas }}", ac: "{{ z11_ac }}"}
        - {name: "{{ z12_name }}", gas: "{{ z12_gas }}", ac: "{{ z12_ac }}"}
      sequence:
        - choose:
            - conditions:
                # skip lege paren
                - condition: template
                  value_template: "{{ repeat.item.gas | length > 0 and repeat.item.ac | length > 0 }}"
                # branch expensive
                - condition: template
                  value_template: "{{ trigger.id == 'expensive' }}"
                # airco staat (niet 'off')
                - condition: template
                  value_template: "{{ states(repeat.item.ac) != 'off' }}"
                # prijs ≥ high OF buiten ≤ low
                - condition: template
                  value_template: "{{ prijs >= price_threshold_high or buiten <= outside_threshold_low }}"
              sequence:
                - alias: "{{ repeat.item.name }}: gas naar target (heat)"
                  service: climate.set_hvac_mode
                  target: { entity_id: "{{ repeat.item.gas }}" }
                  data: { hvac_mode: heat }

                - alias: "{{ repeat.item.name }}: gas set temperatuur (target)"
                  service: climate.set_temperature
                  target: { entity_id: "{{ repeat.item.gas }}" }
                  data: { temperature: "{{ target_temp }}" }

                - alias: "{{ repeat.item.name }}: airco uit"
                  service: climate.turn_off
                  target: { entity_id: "{{ repeat.item.ac }}" }
