
blueprint:
  name: Verwarming schakelen op prijs + buitentemp (hysteresis, 15 min, meerdere climates)
  description: >
    Schakelt tussen gas en airco op basis van elektriciteitsprijs en buitentemperatuur.
    Hysteresis (dead band): naar airco bij prijs ≤ low en buiten ≥ high, naar gas bij prijs ≥ high of buiten ≤ low.
    Triggers pas na 15 minuten onder/boven 0,25 €/kWh om pendelen te voorkomen.
    Ondersteunt meerdere climate-paren (gas ↔ airco), aliassen per zone, en variabele drempels.
  domain: automation
  source_url: https://example.local/blueprints/prijs_hysteresis_climates

  input:
    # --- Sensoren / bronnen ---
    price_sensor:
      name: Elektriciteitsprijs sensor
      description: Sensor met huidige €/kWh prijs (numeriek).
      selector:
        entity:
          domain: sensor

    outside_entity:
      name: Buitentemperatuur (sensor of weather)
      description: Kies een temperatuursensor of weather entity. Wordt automatisch gedetecteerd.
      selector:
        entity:
          domain:
            - sensor
            - weather

    hold_time:
      name: Vasthouden tijd (onder/boven 0,25 €/kWh)
      description: Hoe lang de prijs continu onder/boven 0,25 moet zijn voordat wordt geschakeld.
      default: "00:15:00"
      selector:
        duration: {}

    # --- Drempels & temperaturen ---
    target_temp:
      name: Doeltemperatuur (aan)
      default: 21
      selector:
        number:
          min: 5
          max: 30
          step: 0.5
          unit_of_measurement: °C

    gas_setback_temp:
      name: Gas setback temperatuur
      default: 15
      selector:
        number:
          min: 5
          max: 25
          step: 0.5
          unit_of_measurement: °C

    price_threshold_low:
      name: Lage prijs drempel (naar airco)
      description: Prijs ≤ deze waarde → naar airco, mits buitentemp ≥ hoge drempel.
      default: 0.23
      selector:
        number:
          min: 0
          max: 2
          step: 0.01
          unit_of_measurement: €/kWh

    price_threshold_high:
      name: Hoge prijs drempel (naar gas)
      description: Prijs ≥ deze waarde → naar gas (of bij lage buitentemp).
      default: 0.27
      selector:
        number:
          min: 0
          max: 2
          step: 0.01
          unit_of_measurement: €/kWh

    outside_threshold_high:
      name: Buitentemp drempel hoog (airco)
      description: Buitentemperatuur ≥ deze waarde → airco verwarmen toegestaan.
      default: 7
      selector:
        number:
          min: -30
          max: 40
          step: 0.5
          unit_of_measurement: °C

    outside_threshold_low:
      name: Buitentemp drempel laag (gas)
      description: Buitentemperatuur ≤ deze waarde → terug naar gas.
      default: 5
      selector:
        number:
          min: -30
          max: 40
          step: 0.5
          unit_of_measurement: °C

    # --- Zones (max 12 paren) ---
    # Laat standaard leeg als je minder gebruikt; blueprint slaat lege paren automatisch over.
    zone1_name:
      name: Zone 1 alias
      default: Woonkamer
      selector: text: {}
    zone1_gas:
      name: Zone 1 gas climate
      default: ""
      selector:
        entity:
          domain: climate
    zone1_ac:
      name: Zone 1 airco climate
      default: ""
      selector:
        entity:
          domain: climate

    zone2_name:
      name: Zone 2 alias
      default: Keuken
      selector: text: {}
    zone2_gas:
      name: Zone 2 gas climate
      default: ""
      selector:
        entity:
          domain: climate
    zone2_ac:
